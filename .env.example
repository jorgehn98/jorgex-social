# Copy to .env and adjust. Never commit .env.
# With Docker, compose.yaml fixes the database, media and secret key paths under /data.

# SQLite file shared by the API server and the worker.
JORGEX_SOCIAL_DATABASE_PATH=data/jorgex-social.db

# true: never calls the real network. Set to false only after connecting your own Meta app.
JORGEX_SOCIAL_SIMULATION=true

# The API reference (/docs, /redoc, /openapi.json) is served in simulation. With SIMULATION=false it
# answers 404 unless this is true.
JORGEX_SOCIAL_API_DOCS=false

# How often the worker looks for due work.
JORGEX_SOCIAL_WORKER_INTERVAL_SECONDS=10

# Uploaded media are stored here and deleted seven days after they are published.
JORGEX_SOCIAL_MEDIA_DIR=data/media

# Public HTTPS base URL of this service (for example https://social.example.com). Instagram downloads
# media from it, so it is required when SIMULATION=false. The web interface also accepts form posts
# only from this origin (or from localhost through the SSH tunnel). It is also the OAuth issuer
# remote MCP clients sign in with: without it there is neither OAuth nor /mcp.
JORGEX_SOCIAL_PUBLIC_URL=

# OAuth clients may only register loopback redirect URIs (http://127.0.0.1, localhost or [::1], any
# port), which send the answer back to the operator's own machine. https ones listed here
# (comma-separated, matched exactly) are accepted too. Leave empty unless a client needs one.
# JORGEX_SOCIAL_OAUTH_REDIRECT_URIS=

# A scheduled post the worker finds later than this many minutes fails instead of going out late.
JORGEX_SOCIAL_PUBLISH_GRACE_MINUTES=30

# 32-byte key that encrypts the stored Instagram credential; `migrate` creates it (mode 600) if it
# is missing. Back it up separately from the database: one without the other is useless to a thief.
# The Instagram token itself is never configured here: run `jorgex-social connect-instagram`.
JORGEX_SOCIAL_SECRET_KEY_FILE=data/secret.key

# Automatic replies: how often comments and direct messages are polled, the most replies sent in
# any hour (Meta allows 750 private replies an hour), the most of those that may be public (reported
# to be the riskier kind, on community evidence only), the most replies sent in any minute (the rest
# wait for a later pass), and how many days events, replies and conversations are kept. Comment and
# message text is never stored.
JORGEX_SOCIAL_REPLY_POLL_SECONDS=120
JORGEX_SOCIAL_HOURLY_REPLY_CAP=200
JORGEX_SOCIAL_HOURLY_PUBLIC_REPLY_CAP=30
JORGEX_SOCIAL_REPLIES_PER_MINUTE=12
JORGEX_SOCIAL_RETENTION_DAYS=90
# A message rule answers the same person at most once in this many minutes.
JORGEX_SOCIAL_REPLY_COOLDOWN_MINUTES=60
# A direct message that is exactly one of these (comma-separated; case, accents and punctuation or
# symbols at its ends are ignored, so "Stop!" counts and "stop it" does not) silences automatic
# replies to that person until resumed by hand. Empty turns it off.
JORGEX_SOCIAL_OPT_OUT_WORDS=stop,unsubscribe,baja

# Meta webhook: replies within seconds instead of at the next poll. Both must be set, or /webhook
# answers 404 and polling alone handles replies. The verify token is any random string you also type
# into Meta's dashboard (for example `openssl rand -hex 32`). The app secret is the Instagram app
# secret shown on the dashboard's "API setup with Instagram login" page, not the one under
# App settings > Basic (see INSTALL.md). Keep this file mode 600.
JORGEX_SOCIAL_WEBHOOK_VERIFY_TOKEN=
JORGEX_SOCIAL_META_APP_SECRET=
# A direct message sent by hand from Instagram pauses automatic replies to that person this long.
JORGEX_SOCIAL_HUMAN_PAUSE_MINUTES=30

# Web interface sign-in attempts allowed per client address (IPv6: per /64). No account lockout.
JORGEX_SOCIAL_LOGIN_LIMIT_PER_MINUTE=5
JORGEX_SOCIAL_LOGIN_LIMIT_PER_HOUR=20

# Addresses whose X-Forwarded-For is believed: the reverse proxy, as the service sees it. Without
# Docker it defaults to 127.0.0.1,::1. With Docker, compose.yaml sets it to the gateway of its
# network and ignores this line; if that subnet collides with one you have, change both of these
# instead (the gateway inside the subnet).
# JORGEX_SOCIAL_FORWARDED_ALLOW_IPS=127.0.0.1,::1
# JORGEX_SOCIAL_DOCKER_SUBNET=172.30.250.0/24
# JORGEX_SOCIAL_DOCKER_GATEWAY=172.30.250.1
