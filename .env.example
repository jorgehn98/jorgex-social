# Copy to .env and adjust. Never commit .env.
# With Docker, compose.yaml fixes the database, media and secret key paths under /data.

# SQLite file shared by the API server and the worker.
JORGEX_SOCIAL_DATABASE_PATH=data/jorgex-social.db

# true: never calls the real network. Set to false only after connecting your own Meta app.
JORGEX_SOCIAL_SIMULATION=true

# How often the worker looks for due work.
JORGEX_SOCIAL_WORKER_INTERVAL_SECONDS=10

# Uploaded media are stored here and deleted seven days after they are published.
JORGEX_SOCIAL_MEDIA_DIR=data/media

# Public HTTPS base URL of this service (for example https://social.example.com). Instagram downloads
# media from it, so it is required when SIMULATION=false.
JORGEX_SOCIAL_PUBLIC_URL=

# A scheduled post the worker finds later than this many minutes fails instead of going out late.
JORGEX_SOCIAL_PUBLISH_GRACE_MINUTES=30

# 32-byte key that encrypts the stored Instagram credential; `migrate` creates it (mode 600) if it
# is missing. Back it up separately from the database: one without the other is useless to a thief.
# The Instagram token itself is never configured here: run `jorgex-social connect-instagram`.
JORGEX_SOCIAL_SECRET_KEY_FILE=data/secret.key

# Automatic replies: how often comments and direct messages are polled, the most replies sent in
# any hour (Meta allows 750 private replies an hour), and how many days events, replies and
# conversations are kept. Comment and message text is never stored.
JORGEX_SOCIAL_REPLY_POLL_SECONDS=120
JORGEX_SOCIAL_HOURLY_REPLY_CAP=200
JORGEX_SOCIAL_RETENTION_DAYS=90
# A message rule answers the same person at most once in this many minutes.
JORGEX_SOCIAL_REPLY_COOLDOWN_MINUTES=60
